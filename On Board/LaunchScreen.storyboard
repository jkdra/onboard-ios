<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchScreen.storyboard

  Deliberately identical to RootView's bootstrap view: systemBackground, with the
  Host mark centred at 72x72. The launch image hands straight over to the SwiftUI
  gate with nothing moving, so the app appears to start on the Host rather than
  flashing a blank screen and then drawing one.

  Uses LaunchHost, a separate imageset carrying explicit light/dark appearance
  variants, rather than HostIdle itself. RootView flips the sprite with
  .colorInverted in dark mode, which a storyboard can't do. Templating and tinting
  was the obvious shortcut and it does not work — the artwork relies on transparent
  negative space for the face and the counter of the B, so a template flattens the
  whole thing into a black silhouette. The variants are rendered from HostIdle.pdf
  with the RGB forced to white over the original alpha, which is what .colorInvert()
  produces for all-black art.

  Keeping it a separate imageset also means none of this can leak into CountdownCard
  or HostSpeechBubble, which rely on HostIdle staying vector and "original".

  Launch storyboards may not reference custom classes or run any code.
-->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="22505" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="01J-lp-oVM">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22504"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="Ze5-6b-2t3">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LaunchHost" translatesAutoresizingMaskIntoConstraints="NO" id="Hst-Mk-72p">
                                <rect key="frame" x="160.5" y="390" width="72" height="72"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="72" id="wid-72-cst"/>
                                    <constraint firstAttribute="height" constant="72" id="hgt-72-cst"/>
                                </constraints>
                                
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="6Tk-OE-BBY"/>
                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                        <constraints>
                            <constraint firstItem="Hst-Mk-72p" firstAttribute="centerX" secondItem="Ze5-6b-2t3" secondAttribute="centerX" id="ctr-x-cst"/>
                            <constraint firstItem="Hst-Mk-72p" firstAttribute="centerY" secondItem="Ze5-6b-2t3" secondAttribute="centerY" id="ctr-y-cst"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="iYj-Kq-Ea1" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="53" y="375"/>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchHost" width="64" height="72"/>
        <systemColor name="labelColor">
            <color red="0.0" green="0.0" blue="0.0" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </systemColor>
        <systemColor name="systemBackgroundColor">
            <color white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
        </systemColor>
    </resources>
</document>
