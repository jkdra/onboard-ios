// Maintainer-only: keys for the official On Board Supabase project.
// iOS contributors do NOT need this file — copy is optional for local builds
// against production; without it the app uses mock auth and sample data.
//
//   cp Secrets.xcconfig.example Secrets.xcconfig
//
// Never commit Secrets.xcconfig.

SUPABASE_URL = https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY = your-publishable-or-anon-key
GOOGLE_CLIENT_ID = your-ios-client-id.apps.googleusercontent.com
