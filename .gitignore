*.dSYM

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Local API keys — copy Secrets.xcconfig.example → Secrets.xcconfig
Secrets.xcconfig

# Backend is intentionally NOT version-controlled in this repo.
# The Supabase schema, RLS policies, migrations, and edge functions are kept
# local-only so the backend can't be reconstructed from the public app code.
# Anchored to repo root (leading slash) — an unanchored "supabase/" also matched
# "On Board/Supabase/" (the client Swift code) because macOS git defaults to
# case-insensitive matching, silently dropping new files added there from git
# with no warning (they don't even show as untracked in `git status`).
/supabase/

# Environment overrides
.env
.env.*
!.env.example

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

# Claude Code internals
.agents/
.mcp.json
skills-lock.json
.claude/
